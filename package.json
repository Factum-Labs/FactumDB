{
  "name": "factumdb",
  "private": true,
  "version": "0.1.0",
  "description": "FactumDB — MySQL/InnoDB forensic examination workbench",
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "bundle:windows:prepare": "py -3 scripts/prepare_windows_bundle.py",
    "bundle:windows": "npm run bundle:windows:prepare && tauri build --target x86_64-pc-windows-msvc",
    "bundle:linux:prepare": "python3 scripts/prepare_linux_bundle.py",
    "bundle:linux": "python3 scripts/build_linux_bundle.py",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:install": "npm --prefix frontend install"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
